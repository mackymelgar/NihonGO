# Supabase — client-side (safe to expose; protected by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SEED SCRIPT ONLY, never import into client code.
# Used by scripts/seed.ts. Keep out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# Direct Postgres connection — MIGRATION RUNNER ONLY (npm run migrate).
# Supabase → Project Settings → Database → Connection string → URI.
# Use the direct connection (port 5432), not the transaction pooler (6543).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
